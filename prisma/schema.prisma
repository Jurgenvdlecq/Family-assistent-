// Datamodel voor Family Assistant v1.1
// Elf kernentiteiten conform sectie 3 van het technisch ontwerpdocument.
// Polymorfe referenties (owner_type/owner_id, subject_type/subject_id) zijn
// bewust gewone velden zonder Prisma @relation — Prisma ondersteunt geen
// echte polymorfe foreign keys; integriteit wordt op applicatieniveau bewaakt.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Household ────────────────────────────────────────────────────────────

model Household {
  id                          String           @id @default(uuid())
  name                        String
  weeklyRhythm                Json             @default("{}") @map("weekly_rhythm")
  deliveryPreference          Json             @default("{}") @map("delivery_preference")
  onboardingStatus            OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingMode              OnboardingMode   @default(QUICK) @map("onboarding_mode")
  planningStyle               PlanningStyle    @default(BALANCED) @map("planning_style")
  maxSmartQuestionsPerSession Int              @default(2) @map("max_smart_questions_per_session")
  // Huishoudbrede harde regel (MEAL_PLANNING_GAP_PLAN.md, wens 2: "geen vis"),
  // los van een individuele allergie op Person.hardRestrictions — geen
  // gezondheidsreden maar een bewuste gezinskeuze die voor iedereen geldt,
  // ongeacht wie er die dag mee-eet. Zelfde gecontroleerde vocabulaire en
  // opslagvorm als Person.hardRestrictions (zie src/lib/dietaryRestrictions.ts),
  // zodat de bestaande matching-/filterlogica dit zonder aparte code kan
  // meenemen — alleen de plek waar de tags vandaan komen verschilt.
  hardRestrictions            Json             @default("[]") @map("hard_restrictions")
  // Vervangt de oude losse toegangscode (gebruikersverzoek: gebruikersnaam +
  // wachtwoord is makkelijker te onthouden). `username` is uniek over ALLE
  // huishoudens — dat is bewust de eigenlijke bescherming tegen twee
  // huishoudens die toevallig dezelfde inloggegevens kiezen: een unieke
  // gebruikersnaam maakt de combinatie per definitie ondubbelzinnig, in
  // plaats van te vertrouwen op "toevallig nooit dezelfde combinatie kiezen"
  // (dat laatste bleek bij het testen alsnog tot verwarring te kunnen leiden
  // — zie de login-logica in src/lib/auth.ts). Genormaliseerd (kleine
  // letters, getrimd) opgeslagen zodat de vergelijking niet hoofdlettergevoelig is.
  username                    String?          @unique
  passwordHash                String?          @map("password_hash")
  // Picnic-integratie (fase 4/7, verdiept): sessie-token van de niet-officiële
  // Picnic-API. Nooit een wachtwoord — dat komt nooit verder dan de "Picnic
  // koppelen"-actie op /ons-gezin (of het losse scripts/picnic-login.ts),
  // wordt alleen gebruikt om rechtstreeks bij Picnic in te loggen en
  // daarna meteen weggegooid.
  picnicAuthToken             String?          @map("picnic_auth_token")
  picnicTokenUpdatedAt        DateTime?        @map("picnic_token_updated_at")
  // Tijdelijk, gedeeltelijk geauthenticeerd token dat Picnic teruggeeft
  // wanneer tweestapsverificatie nodig is — pas bruikbaar om de sms/e-mail-
  // code te verifiëren, nog niet als volwaardige sessie. Losstaand veld van
  // picnicAuthToken zodat een halverwege gestaakte koppelpoging nooit per
  // ongeluk voor een echt werkend token wordt aangezien.
  picnicPendingAuthToken      String?          @map("picnic_pending_auth_token")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  persons                Person[]
  mealPlans              MealPlan[]
  mealSuggestions        MealSuggestion[]
  feedbackEvents         FeedbackEvent[]
  fixedGroceries         FixedGrocery[]
  inventoryItems         InventoryItem[]
  productPreferences     HouseholdProductPreference[]
  rejectedProductMatches RejectedProductMatch[]
  sessions               HouseholdSession[]
  recipes                Recipe[]                     @relation("HouseholdRecipes")
  originatedRecipes      Recipe[]                     @relation("OriginatedRecipes")
  learnedPatterns        LearnedPattern[]
  learningPrompts        LearningPrompt[]
  dayRoutines            DayRoutine[]
  mealDayRules           MealDayRule[]
  mealTemplates          MealTemplate[]
  ingredientFulfillments HouseholdIngredientFulfillment[]
  pushSubscriptions      PushSubscription[]
  notificationPreferences NotificationPreference[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  picnicDeliveryPreference PicnicDeliveryPreference?

  @@map("households")
}

// Een expliciet onthouden daggewoonte (WP51, DATAMODEL_AUDIT.md punt 4:
// "eerst expliciet door de gebruiker, later via leervragen bij herhaling").
// Eén routine per dag per huishouden — een nieuwe keuze onthouden vervangt
// de vorige, net als bij vaste boodschappen. ensureMealPlan gebruikt dit als
// voorstel voor die dag, maar nooit ten koste van een harde beperking.
model DayRoutine {
  id              String    @id @default(uuid())
  householdId     String    @map("household_id")
  dayOfWeek       DayOfWeek @map("day_of_week")
  recipeVariantId String    @map("recipe_variant_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeVariant RecipeVariant @relation(fields: [recipeVariantId], references: [id])

  @@unique([householdId, dayOfWeek])
  @@map("day_routines")
}

// Het weekritme van een huishouden: wat voor soort avond is dit, en geldt dat
// elke week of alleen in oneven/even weken.
//
// Verhouding tot wat er al was:
// - `DayRoutine` (één vast recept per weekdag) blijft bestaan en blijft
//   werken. Een dagregel met `fixedRecipeVariantId` is de rijkere opvolger,
//   maar een huishouden dat alleen DayRoutine-rijen heeft merkt niets.
// - **Wie er mee-eet staat hier bewust níét in.** Dat is al vastgelegd in
//   `PersonPresenceOverride` (inclusief pariteit) en `PersonPresenceDateOverride`.
//   Het aantal eters hier herhalen zou een tweede bron van waarheid zijn die
//   gegarandeerd gaat afwijken van de eerste.
// - `profileKey` verwijst naar het register in
//   `src/domain/meal-planning/dayProfiles.ts` — geen enum (elk nieuw profiel
//   zou een migratie zijn) en geen tabel (er is geen scherm waarin je een
//   eigen profiel samenstelt; die bouwen zou een lege belofte zijn).
//   Een onbekende sleutel is geen fout: de planner valt dan terug op de
//   gewone scoring.
model MealDayRule {
  id                   String         @id @default(uuid())
  householdId          String         @map("household_id")
  dayOfWeek            DayOfWeek      @map("day_of_week")
  weekParity           WeekParity     @default(EVERY) @map("week_parity")
  profileKey           String         @map("profile_key")
  /// Optioneel: deze avond is altijd exact dit gerecht (zoals de patatdag).
  fixedRecipeVariantId String?        @map("fixed_recipe_variant_id")
  /// Optioneel: kies bij voorkeur uit deze categorie in plaats van een vast gerecht.
  preferredCategory    RecipeCategory? @map("preferred_category")
  /// Optioneel: stel deze avond samen uit componenten (aardappel + vlees + groente)
  /// in plaats van één recept te kiezen.
  mealTemplateId       String?        @map("meal_template_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  household          Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fixedRecipeVariant RecipeVariant? @relation("MealDayRuleFixedVariant", fields: [fixedRecipeVariantId], references: [id], onDelete: SetNull)
  mealTemplate       MealTemplate?  @relation(fields: [mealTemplateId], references: [id], onDelete: SetNull)

  @@unique([householdId, dayOfWeek, weekParity])
  @@index([householdId])
  @@map("meal_day_rules")
}

// Een samengestelde maaltijd: "AVG" is geen gerecht maar een vorm — een
// aardappelcomponent, een vleescomponent en een groentecomponent, elk met een
// paar opties. Zo hoeft er niet voor elke combinatie (schnitzel + broccoli,
// hamburger + sperziebonen, ...) een apart recept te bestaan, en kan de
// planner de onderdelen los van elkaar afwisselen.
model MealTemplate {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  groups    MealComponentGroup[]
  dayRules  MealDayRule[]
  entries   MealPlanEntry[]

  @@unique([householdId, name])
  @@map("meal_templates")
}

// Eén onderdeel van een samengestelde maaltijd, met de opties die daarvoor in
// aanmerking komen. `sortOrder` bepaalt de volgorde in de naam die de app
// toont ("Schnitzel met aardappelblokjes en broccoli").
model MealComponentGroup {
  id             String            @id @default(uuid())
  mealTemplateId String            @map("meal_template_id")
  role           MealComponentRole
  name           String
  sortOrder      Int               @default(0) @map("sort_order")

  mealTemplate MealTemplate          @relation(fields: [mealTemplateId], references: [id], onDelete: Cascade)
  options      MealComponentOption[]

  @@unique([mealTemplateId, role])
  @@index([mealTemplateId])
  @@map("meal_component_groups")
}

enum MealComponentRole {
  BASE
  PROTEIN
  VEGETABLE
  SIDE
  SAUCE
  OTHER

  @@map("meal_component_role")
}

// Eén keuzemogelijkheid binnen een component, gekoppeld aan een ingrediënt.
//
// `quantityPerPortion` is bewust per persoon en niet "voor het hele gezin",
// anders dan bij een recept: een component is per definitie iets wat je per
// eter afmeet (één schnitzel, 200 gram aardappel). De behoefteberekening
// vermenigvuldigt dit met het aantal aanwezige porties van die avond — zie
// aggregateMealNeeds in src/lib/shoppingList.ts, waar beide vormen
// samenkomen.
model MealComponentOption {
  id                   String @id @default(uuid())
  mealComponentGroupId String @map("meal_component_group_id")
  name                 String
  ingredientId         String @map("ingredient_id")
  quantityPerPortion   Float  @map("quantity_per_portion")
  unit                 Unit

  group      MealComponentGroup       @relation(fields: [mealComponentGroupId], references: [id], onDelete: Cascade)
  ingredient Ingredient               @relation(fields: [ingredientId], references: [id])
  choices    MealPlanEntryComponent[]

  @@index([mealComponentGroupId])
  @@map("meal_component_options")
}

// Welke opties de planner voor één avond heeft gekozen. Bewust een eigen
// tabel en geen JSON-veld op de avond: hierop moet gequeryd kunnen worden
// ("welke groente hadden we vorige week?") om afwisseling te bepalen.
model MealPlanEntryComponent {
  id                    String @id @default(uuid())
  mealPlanEntryId       String @map("meal_plan_entry_id")
  mealComponentOptionId String @map("meal_component_option_id")

  mealPlanEntry MealPlanEntry       @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)
  option        MealComponentOption @relation(fields: [mealComponentOptionId], references: [id], onDelete: Cascade)

  @@unique([mealPlanEntryId, mealComponentOptionId])
  @@index([mealPlanEntryId])
  @@map("meal_plan_entry_components")
}

// Waar een ingrediënt vandaan komt.
//
// Niet alles gaat via Picnic: biefstuk halen sommige huishoudens bij de
// slager, en soms regelt iemand gewoon zelf iets. Zonder dit onderscheid zou
// zo'n product ofwel ten onrechte in het Picnic-mandje belanden, ofwel het
// hele gerecht onplanbaar maken — allebei fout.
enum FulfillmentSource {
  PICNIC
  /// Wel boodschappen, maar ergens anders gekocht.
  OTHER_STORE
  /// Iemand regelt dit zelf; hier hoeft niets voor gekocht te worden.
  SELF_PROVIDED

  @@map("fulfillment_source")
}

// "Biefstuk halen wij zelf" — één keer vastleggen per huishouden, in plaats
// van bij elk recept opnieuw. Elke boodschappenregel voor dit ingrediënt
// erft deze herkomst.
model HouseholdIngredientFulfillment {
  id           String            @id @default(uuid())
  householdId  String            @map("household_id")
  ingredientId String            @map("ingredient_id")
  fulfillment  FulfillmentSource
  /// Optioneel: waar dan, of waarom. Puur voor de gebruiker.
  note         String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("household_ingredient_fulfillments")
}

// Eén deel van een avond waarop niet iedereen hetzelfde eet.
//
// Zonder dit zou "Lynn en Kai eten bolletjes met knakworst, Jurgen en Ellen
// regelen zelf iets" alleen als hele avond te plannen zijn — en dan valt de
// avond weg zodra één deel niets oplevert. Staan er geen delen bij een avond,
// dan is het gewoon één maaltijd voor iedereen (het normale geval).
model MealAssignment {
  id              String            @id @default(uuid())
  mealPlanEntryId String            @map("meal_plan_entry_id")
  /// Wat dit deel is, in gewone taal ("Pizza salami", "Zelf iets halen").
  label           String
  fulfillment     FulfillmentSource @default(PICNIC)
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")

  mealPlanEntry MealPlanEntry          @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)
  persons       MealAssignmentPerson[]
  items         MealAssignmentItem[]

  @@index([mealPlanEntryId])
  @@map("meal_assignments")
}

// Wie er bij dit deel hoort. Bepaalt meteen de porties: alleen de personen
// die op die datum ook echt mee-eten tellen mee.
model MealAssignmentPerson {
  id               String @id @default(uuid())
  mealAssignmentId String @map("meal_assignment_id")
  personId         String @map("person_id")

  mealAssignment MealAssignment @relation(fields: [mealAssignmentId], references: [id], onDelete: Cascade)
  person         Person         @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([mealAssignmentId, personId])
  @@map("meal_assignment_persons")
}

// Wat er voor dit deel nodig is, per persoon — zelfde vorm als een
// componentoptie, zodat de behoefteberekening één regel kent in plaats van
// twee uitzonderingen.
model MealAssignmentItem {
  id                 String @id @default(uuid())
  mealAssignmentId   String @map("meal_assignment_id")
  ingredientId       String @map("ingredient_id")
  quantityPerPortion Float  @map("quantity_per_portion")
  unit               Unit

  mealAssignment MealAssignment @relation(fields: [mealAssignmentId], references: [id], onDelete: Cascade)
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id])

  @@index([mealAssignmentId])
  @@map("meal_assignment_items")
}

model HouseholdSession {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  tokenHash   String   @unique @map("token_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([expiresAt])
  @@map("household_sessions")
}

// Rate limiting voor /login (SYSTEM_AUDIT.md, "Login rate limiting" —
// WP-vervolg deel A5). Eén rij per mislukte inlogpoging, per genormaliseerde
// gebruikersnaam. Bewust database-gebaseerd i.p.v. een in-memory Map: de app
// draait serverless (Vercel) — in-memory state wordt niet betrouwbaar
// gedeeld tussen aanroepen/instanties, en dit project heeft geen Redis/KV
// of vergelijkbare gedeelde cache (geverifieerd: geen zulke dependency in
// package.json). Bevat bewust geen IP-adres — alleen de genormaliseerde
// gebruikersnaam, wat het directe dreigingsmodel uit de audit afdekt
// (herhaald gokken tegen één bekende/geraden gebruikersnaam) zonder
// aanvullende persoonsgegevens te hoeven bewaren.
model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String   @map("identifier")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("onboarding_status")
}

enum OnboardingMode {
  QUICK
  DETAILED

  @@map("onboarding_mode")
}

enum PlanningStyle {
  SAFE
  BALANCED
  ADVENTUROUS

  @@map("planning_style")
}

// Vaste, terugkerende boodschappen van een huishouden (melk, koffie, kaas…)
model FixedGrocery {
  id           String @id @default(uuid())
  householdId  String @map("household_id")
  ingredientId String @map("ingredient_id")
  quantity     Float
  unit         Unit

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("fixed_groceries")
}

// Eenvoudige voorraadstatus per huishouden + ingrediënt (Fase 2: "geen
// complex magazijnsysteem"). `status` is de bron van waarheid voor de
// boodschappenflow; `quantity`/`unit` zijn optioneel voor wie een preciezer
// aantal wil vastleggen. Blijft — in tegenstelling tot Picnic-besteller —
// gewoon bewaard tussen weken totdat de gebruiker het zelf bijwerkt.
model InventoryItem {
  id           String          @id @default(uuid())
  householdId  String          @map("household_id")
  ingredientId String          @map("ingredient_id")
  status       InventoryStatus @default(UNKNOWN)
  quantity     Float?
  unit         Unit?
  updatedAt    DateTime        @updatedAt @map("updated_at")

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("inventory_items")
}

enum InventoryStatus {
  SUFFICIENT
  LOW
  OUT_OF_STOCK
  UNKNOWN

  @@map("inventory_status")
}

// ── Person ───────────────────────────────────────────────────────────────

model Person {
  id                String     @id @default(uuid())
  householdId       String     @map("household_id")
  name              String
  role              PersonRole @default(OTHER)
  hardRestrictions  Json       @default("[]") @map("hard_restrictions")
  defaultPresent    Boolean    @default(true) @map("default_present")
  portionMultiplier Float      @default(1) @map("portion_multiplier")
  createdAt         DateTime   @default(now()) @map("created_at")

  household             Household                    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  feedbackEvents        FeedbackEvent[]
  presenceOverrides     PersonPresenceOverride[]
  presenceDateOverrides PersonPresenceDateOverride[]
  mealAssignments       MealAssignmentPerson[]

  @@index([householdId])
  @@map("persons")
}

// Het verwachte aanwezigheidspatroon: "op deze weekdag eet deze persoon wel
// of juist niet mee". `weekParity` maakt een tweewekelijks ritme mogelijk
// (vrijdag in een oneven week met z'n vieren, in een even week met z'n
// tweeën) zonder een tweede tabel naast deze — aanwezigheid heeft al één
// bron van waarheid, en die houden we zo.
//
// Oplossing per persoon per datum, van specifiek naar algemeen:
//   1. een uitzondering voor precies die datum (PersonPresenceDateOverride)
//   2. de regel voor de pariteit van die week (ODD/EVEN)
//   3. de regel die elke week geldt (EVERY)
//   4. Person.defaultPresent
// Bestaande rijen krijgen EVERY en gedragen zich daardoor exact zoals vóór
// het weekritme.
model PersonPresenceOverride {
  id         String     @id @default(uuid())
  personId   String     @map("person_id")
  dayOfWeek  DayOfWeek  @map("day_of_week")
  weekParity WeekParity @default(EVERY) @map("week_parity")
  present    Boolean
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, dayOfWeek, weekParity])
  @@index([personId])
  @@map("person_presence_overrides")
}

// Een afwijking voor één concrete datum: "deze ene vrijdag eet Kai niet mee".
//
// Bewust een eigen tabel en niet een extra veld op het patroon hierboven: een
// uitzondering mag het verwachte ritme nóóit stilzwijgend veranderen. Eén
// afwijkende vrijdag betekent niet dat vrijdag voortaan anders is — pas als
// zoiets zich herhaalt mag de app ernaar vrágen (leerlaag), en dan nog is het
// de gebruiker die het patroon wijzigt.
model PersonPresenceDateOverride {
  id        String   @id @default(uuid())
  personId  String   @map("person_id")
  date      DateTime @db.Date
  present   Boolean
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, date])
  @@index([personId, date])
  @@map("person_presence_date_overrides")
}

// Op welke weken een ritmeregel van toepassing is, op basis van het
// ISO-8601-weeknummer (zie src/domain/week/isoWeek.ts). EVERY is de standaard
// en het enige dat bestond vóór het weekritme.
enum WeekParity {
  EVERY
  ODD
  EVEN

  @@map("week_parity")
}

enum PersonRole {
  PARENT
  CHILD
  OTHER

  @@map("person_role")
}

// ── Recipe & RecipeVariant ──────────────────────────────────────────────

model Recipe {
  id                String         @id @default(uuid())
  title             String
  category          RecipeCategory
  source            String?
  imageUrl          String?        @map("image_url")
  imageAttribution  String?        @map("image_attribution")
  imageSourceUrl    String?        @map("image_source_url")
  properties        String[]       @default([])
  instructions      String[]       @default([])
  status            RecipeStatus   @default(FOUND)
  scope             RecipeScope    @default(GLOBAL)
  householdId       String?        @map("household_id")
  originHouseholdId String?        @map("origin_household_id")
  promotedAt        DateTime?      @map("promoted_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  household       Household?         @relation("HouseholdRecipes", fields: [householdId], references: [id], onDelete: Cascade)
  originHousehold Household?         @relation("OriginatedRecipes", fields: [originHouseholdId], references: [id], onDelete: SetNull)
  ingredients     RecipeIngredient[]
  variants        RecipeVariant[]

  @@index([scope, householdId, title])
  @@map("recipes")
}

enum RecipeScope {
  GLOBAL
  HOUSEHOLD
  COMMUNITY_CANDIDATE
  COMMUNITY_APPROVED

  @@map("recipe_scope")
}

enum RecipeCategory {
  PASTA
  WRAPS
  RICE_DISH
  ALL_VEGGIE_DAY
  QUICK_AND_EASY
  COMFORT_FOOD
  AIRFRYER
  OTHER

  @@map("recipe_category")
}

enum RecipeStatus {
  FOUND
  ADAPTED
  PROVEN
  SAFE_CHOICE

  @@map("recipe_status")
}

// Join-tabel: ingrediënt + hoeveelheid per recept (basisrecept, vóór variant-overrides)
model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String @map("recipe_id")
  ingredientId String @map("ingredient_id")
  quantity     Float
  unit         Unit

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeVariant {
  id                  String      @id @default(uuid())
  recipeId            String      @map("recipe_id")
  variantType         VariantType @map("variant_type")
  ingredientOverrides Json        @default("{}") @map("ingredient_overrides")
  contextFit          String[]    @default([]) @map("context_fit")
  createdAt           DateTime    @default(now()) @map("created_at")

  recipe                          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealSuggestions                 MealSuggestion[]
  mealPlanEntries                 MealPlanEntry[]
  dayRoutines                     DayRoutine[]
  mealDayRules                    MealDayRule[]    @relation("MealDayRuleFixedVariant")
  mealPlanEntriesReplacedFromThis MealPlanEntry[]  @relation("MealPlanEntryReplacedFrom")

  @@unique([recipeId, variantType])
  @@map("recipe_variants")
}

enum VariantType {
  FAST
  FRESH
  REHEATABLE
  KID_FRIENDLY

  @@map("variant_type")
}

// ── MealPlan ─────────────────────────────────────────────────────────────

model MealPlan {
  id          String         @id @default(uuid())
  householdId String         @map("household_id")
  weekStart   DateTime       @map("week_start") @db.Date
  status      MealPlanStatus @default(CONCEPT)
  createdAt   DateTime       @default(now()) @map("created_at")

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries      MealPlanEntry[]
  shoppingList ShoppingList?

  @@unique([householdId, weekStart])
  @@map("meal_plans")
}

enum MealPlanStatus {
  CONCEPT
  CONFIRMED
  GROCERIES_READY

  @@map("meal_plan_status")
}

// De 7 dagregels van een weekplanning
//
// source/status/reason/score/confidenceLevel (WP52, DATAMODEL_AUDIT.md
// punt 6) maken onderscheid tussen "de app heeft dit voorgesteld en de
// gebruiker heeft er niets aan veranderd" (stilzwijgende bevestiging is
// zelf ook een signaal, PRODUCT_VISION.md: "Stilte is feedback") en een
// expliciete, actieve keuze — nodig om daar later verschillend van te
// kunnen leren.
model MealPlanEntry {
  id                          String              @id @default(uuid())
  mealPlanId                  String              @map("meal_plan_id")
  dayOfWeek                   DayOfWeek           @map("day_of_week")
  // Optioneel sinds de samengestelde maaltijden: een avond is óf een recept,
  // óf een samenstelling uit componenten (`mealTemplateId` + `components`).
  // Alle bestaande rijen hebben een recept, dus deze kolom nullable maken
  // verandert niets aan wat er al staat.
  recipeVariantId             String?             @map("recipe_variant_id")
  mealTemplateId              String?             @map("meal_template_id")
  source                      MealPlanEntrySource @default(AUTO) @map("source")
  status                      MealPlanEntryStatus @default(PROPOSED) @map("status")
  reason                      String?             @map("reason")
  score                       Float?              @map("score")
  confidenceLevel             ConfidenceLevel?    @map("confidence_level")
  replacedFromRecipeVariantId String?             @map("replaced_from_recipe_variant_id")
  // Gebruiker eet deze dag niet thuis (bv. uit eten) — de dag blijft
  // gewoon een geplande maaltijd behouden (voor geschiedenis/varatie),
  // maar telt niet mee in de boodschappenlijst en niet als stille
  // acceptatie van het voorgestelde gerecht (dat zou anders ten onrechte
  // voorkeuren/geleerde patronen beïnvloeden voor een maaltijd die nooit
  // gekookt is).
  skipped                     Boolean             @default(false) @map("skipped")
  // Neemt deze avond mee in de boodschappen van de eerstvolgende bestelling.
  // Bewust een ander veld dan `skipped`: "we gaan uit eten" en "hier koop ik
  // nu geen boodschappen voor" zijn twee verschillende dingen (je kunt thuis
  // koken van wat er al ligt). Ze delen alleen het gevolg dat de dag niet
  // meetelt in de lijst.
  //
  // Standaard `false`, want de app is sinds de koerswijziging "boodschappen
  // eerst" opt-in per avond: een nieuwe week begint met alleen de vaste
  // boodschappen, en de gebruiker tikt zelf aan voor welke avonden er
  // gekookt wordt. De migratie zet bestaande rijen op `true`, zodat al
  // geplande weken zich blijven gedragen zoals de gebruiker ze achterliet.
  includedInGroceries         Boolean             @default(false) @map("included_in_groceries")
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  mealPlan            MealPlan                 @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeVariant       RecipeVariant?           @relation(fields: [recipeVariantId], references: [id])
  mealTemplate        MealTemplate?            @relation(fields: [mealTemplateId], references: [id], onDelete: SetNull)
  components          MealPlanEntryComponent[]
  assignments         MealAssignment[]
  replacedFromVariant RecipeVariant? @relation("MealPlanEntryReplacedFrom", fields: [replacedFromRecipeVariantId], references: [id], onDelete: SetNull)

  @@unique([mealPlanId, dayOfWeek])
  @@map("meal_plan_entries")
}

enum MealPlanEntrySource {
  AUTO
  MANUAL
  ASSISTANT
  REGENERATED

  @@map("meal_plan_entry_source")
}

enum MealPlanEntryStatus {
  PROPOSED
  ACCEPTED
  REPLACED

  @@map("meal_plan_entry_status")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
}

// ── MealSuggestion ───────────────────────────────────────────────────────

model MealSuggestion {
  id              String          @id @default(uuid())
  householdId     String          @map("household_id")
  recipeVariantId String          @map("recipe_variant_id")
  reason          String
  confidenceLevel ConfidenceLevel @map("confidence_level")
  targetSlot      DateTime        @map("target_slot") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeVariant RecipeVariant @relation(fields: [recipeVariantId], references: [id])

  @@index([householdId, targetSlot])
  @@map("meal_suggestions")
}

enum ConfidenceLevel {
  CERTAIN
  SLIGHT_DOUBT
  HIGH_IMPACT

  @@map("confidence_level")
}

// ── Ingredient & Product ─────────────────────────────────────────────────

model Ingredient {
  id              String             @id @default(uuid())
  name            String             @unique
  unit            Unit
  category        IngredientCategory
  // Gecontroleerd vocabulaire (zie src/lib/dietaryRestrictions.ts) waarmee
  // een harde beperking van een gezinslid ("pinda's", "lactose", ...)
  // betrouwbaar aan een ingrediënt kan worden gekoppeld. Bewust geen vrije
  // tekst: alleen tags uit dat vocabulaire mogen hier terechtkomen.
  restrictionTags String[]           @default([]) @map("restriction_tags")
  // Kandidaat voor de voorraadcontrole (Fase 4): een pantry-basisproduct dat
  // waarschijnlijk al in huis is (olie, bloem, bouillon, ...), dus de moeite
  // waard om ernaar te vragen — in tegenstelling tot verse producten die
  // sowieso elke keer opnieuw gekocht worden.
  likelyInStock   Boolean            @default(false) @map("likely_in_stock")

  recipeIngredients      RecipeIngredient[]
  fixedGroceries         FixedGrocery[]
  products               Product[]
  shoppingListLines      ShoppingListLine[]
  inventoryItems         InventoryItem[]
  productPreferences     HouseholdProductPreference[]
  rejectedProductMatches RejectedProductMatch[]
  mealComponentOptions   MealComponentOption[]
  assignmentItems        MealAssignmentItem[]
  householdFulfillments  HouseholdIngredientFulfillment[]

  @@map("ingredients")
}

enum Unit {
  GRAM
  PIECE
  ML

  @@map("unit")
}

enum IngredientCategory {
  MEAT
  FISH
  DAIRY
  VEGETABLE
  FRUIT
  GRAIN
  LEGUME
  PANTRY
  OTHER

  @@map("ingredient_category")
}

model Product {
  id                String          @id @default(uuid())
  ingredientId      String?         @map("ingredient_id")
  // Bij welke winkel-/dataleverancier externalRef hoort. Vandaag altijd
  // PICNIC (de enige geïntegreerde provider) — expliciet gemaakt zodat
  // externalRef niet stilzwijgend als "het Picnic-product-ID" wordt
  // aangenomen, en een toekomstige tweede provider niet per ongeluk op
  // dezelfde (ingredientId, externalRef)-combinatie kan botsen.
  provider          ProductProvider @default(PICNIC)
  externalRef       String?         @map("external_ref")
  picnicImageId     String?         @map("picnic_image_id")
  name              String
  brand             String?
  packageSize       String?         @map("package_size")
  // Structureel aantal eenheden (in de eenheid van het gekoppelde
  // Ingredient) per verpakking — bv. 500 voor "500 gram", 4 voor "4 stuks".
  // Null wanneer packageSize niet betrouwbaar te herleiden is tot de
  // ingrediënt-eenheid (zie src/lib/quantity/parsePackageSize.ts); dan is
  // handmatige controle nodig in plaats van een geraden waarde.
  packageQuantity   Float?          @map("package_quantity")
  price             Decimal?        @db.Decimal(10, 2)
  lastSeenAvailable DateTime?       @map("last_seen_available")

  ingredient           Ingredient?                  @relation(fields: [ingredientId], references: [id])
  shoppingListLines    ShoppingListLine[]
  householdPreferences HouseholdProductPreference[]
  rejections           RejectedProductMatch[]

  @@unique([ingredientId, provider, externalRef])
  @@index([ingredientId])
  @@map("products")
}

enum ProductProvider {
  PICNIC

  @@map("product_provider")
}

// Vervangt het generieke gebruik van Preference{subjectType: PRODUCT} met
// iets rijkers (Fase 2 / Fase 5): niet alleen "vertrouwd of niet", maar ook
// hoe vaak en wanneer voor het laatst gekozen, en of dat automatisch of
// handmatig gebeurde. Eén actieve voorkeur per ingrediënt per huishouden.
model HouseholdProductPreference {
  id           String                  @id @default(uuid())
  householdId  String                  @map("household_id")
  ingredientId String                  @map("ingredient_id")
  productId    String                  @map("product_id")
  timesChosen  Int                     @default(1) @map("times_chosen")
  lastChosenAt DateTime                @default(now()) @map("last_chosen_at")
  confidence   Float                   @default(1)
  source       ProductPreferenceSource @default(MANUAL)

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("household_product_preferences")
}

enum ProductPreferenceSource {
  MANUAL
  AUTOMATIC

  @@map("product_preference_source")
}

// Een product dat een huishouden expliciet heeft afgewezen voor een
// ingrediënt — sluit het uit van toekomstige automatische matches voor dat
// ingrediënt (Fase 5: "afgewezen producten").
model RejectedProductMatch {
  id           String   @id @default(uuid())
  householdId  String   @map("household_id")
  ingredientId String   @map("ingredient_id")
  productId    String   @map("product_id")
  reason       String?
  rejectedAt   DateTime @default(now()) @map("rejected_at")

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([householdId, ingredientId, productId])
  @@map("rejected_product_matches")
}

// ── ShoppingList ─────────────────────────────────────────────────────────

model ShoppingList {
  id         String             @id @default(uuid())
  mealPlanId String             @unique @map("meal_plan_id")
  status     ShoppingListStatus @default(PREPARED)
  createdAt  DateTime           @default(now()) @map("created_at")

  // WP69: betrouwbare "sinds wanneer"-tijdstempels voor rustige
  // herinneringen (attention-laag) — het bestaande status-veld alleen zegt
  // niet hoe lang een toestand al openstaat. Geen @updatedAt: die zou ook
  // bij ongerelateerde regel-writes meebewegen en de "stale"-klok onterecht
  // resetten.
  reviewFlaggedAt  DateTime? @map("review_flagged_at")
  reviewedAt       DateTime? @map("reviewed_at")
  // Expliciete, optionele gebruikersbevestiging "ik heb besteld" — nooit
  // automatisch afgeleid, want Family Assistant kan een Picnic-bestelling
  // nooit betrouwbaar zelf verifiëren (Fase 7/8).
  orderConfirmedAt DateTime? @map("order_confirmed_at")

  mealPlan MealPlan           @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  lines    ShoppingListLine[]

  @@map("shopping_lists")
}

enum ShoppingListStatus {
  PREPARED
  REVIEWED
  TRANSFERRED

  @@map("shopping_list_status")
}

model ShoppingListLine {
  id              String      @id @default(uuid())
  shoppingListId  String      @map("shopping_list_id")
  ingredientId    String      @map("ingredient_id")
  productId       String?     @map("product_id")
  quantity        Float
  unit            Unit
  source          LineSource
  needsReview     Boolean     @default(false) @map("needs_review")
  // Uitlegbare productmatching (Fase 5) — needsReview blijft de simpele
  // boolean die de bestaande UI al gebruikt, deze velden voegen het "hoe
  // zeker, en waarom" toe. matchReasons is bewust String[] i.p.v. één
  // opgebouwde zin: elk element is een losse, voor de gebruiker leesbare
  // reden (zie src/domain/product-matching).
  matchStatus     MatchStatus @default(NOT_FOUND) @map("match_status")
  matchConfidence Float       @default(0) @map("match_confidence")
  matchReasons    String[]    @default([]) @map("match_reasons")

  // Fase 7/8: per-regel idempotentie voor het vullen van het Picnic-mandje —
  // een regel die al is overgedragen wordt bij een herhaalde poging
  // overgeslagen in plaats van dubbel toegevoegd.
  transferredToPicnicAt DateTime? @map("transferred_to_picnic_at")

  // Nooit stilzwijgend onder-bestellen (Fase 3/8): als een regel handmatig
  // (of nog niet bijgewerkt) onder de daadwerkelijke receptbehoefte van deze
  // week staat, moet de gebruiker dat expliciet zien en bevestigen dat dit
  // oké is — anders blijft de melding terugkomen. Wordt teruggezet zodra de
  // hoeveelheid weer handmatig wijzigt, zodat een nieuw tekort niet stil
  // wordt overgeslagen.
  shortfallAcknowledged Boolean @default(false) @map("shortfall_acknowledged")

  // Waar dit product vandaan komt. Alleen PICNIC-regels gaan mee naar het
  // Picnic-mandje; de rest verschijnt als "zelf halen". Standaard PICNIC,
  // dus voor bestaande regels verandert er niets.
  fulfillment FulfillmentSource @default(PICNIC)

  // Afvinklijst voor zelf boodschappen doen (in een fysieke winkel, of
  // gewoon om bij te houden wat al in het mandje ligt) — losstaand van
  // transferredToPicnicAt: een huishouden kan beide tegelijk gebruiken
  // (bijv. het grootste deel via Picnic, verse producten zelf gehaald).
  pickedUpAt DateTime? @map("picked_up_at")

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([shoppingListId])
  @@index([shoppingListId, needsReview])
  @@index([shoppingListId, ingredientId, source])
  @@map("shopping_list_lines")
}

enum MatchStatus {
  MATCHED_TRUSTED
  MATCHED_REVIEW_REQUIRED
  NOT_FOUND
  MANUALLY_SELECTED
  UNAVAILABLE

  @@map("match_status")
}

enum LineSource {
  MEAL
  FIXED
  // Toegevoegd omdat de voorraadcontrole een pantry-item als "bijna op"/"op"
  // markeerde, terwijl geen enkel recept deze week dat ingrediënt gebruikt —
  // dus geen MEAL-regel om aan te vullen. Altijd needsReview: de gebruiker
  // gaf alleen een status door, geen exacte hoeveelheid.
  INVENTORY
  // Eenmalig, handmatig toegevoegd product (gebruikersverzoek: kinderen
  // moeten makkelijk iets aan de lijst kunnen toevoegen) — in tegenstelling
  // tot FIXED wordt dit nooit een blijvende wekelijkse gewoonte, alleen een
  // regel voor de huidige week.
  MANUAL

  @@map("line_source")
}

// ── FeedbackEvent ────────────────────────────────────────────────────────

model FeedbackEvent {
  id          String              @id @default(uuid())
  householdId String              @map("household_id")
  personId    String?             @map("person_id")
  subjectType FeedbackSubjectType @map("subject_type")
  subjectId   String              @map("subject_id")
  eventType   FeedbackEventType   @map("event_type")
  reason      FeedbackReason?
  explicit    Boolean             @default(false)
  context     Json                @default("{}")
  createdAt   DateTime            @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id])

  @@index([householdId, subjectType, subjectId])
  @@index([householdId, eventType, subjectType, subjectId])
  @@map("feedback_events")
}

// ── Learning ─────────────────────────────────────────────────────────────

model LearnedPattern {
  id             String               @id @default(uuid())
  householdId    String               @map("household_id")
  personId       String?              @map("person_id")
  patternType    LearnedPatternType   @map("pattern_type")
  subjectType    FeedbackSubjectType? @map("subject_type")
  subjectId      String?              @map("subject_id")
  contextKey     String               @map("context_key")
  context        Json                 @default("{}")
  confidence     Float                @default(0)
  evidenceCount  Int                  @default(0) @map("evidence_count")
  status         LearningStatus       @default(CANDIDATE)
  lastObservedAt DateTime             @default(now()) @map("last_observed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  prompts   LearningPrompt[]

  @@unique([householdId, patternType, subjectType, subjectId, contextKey])
  @@index([householdId, status])
  @@map("learned_patterns")
}

model LearningPrompt {
  id               String             @id @default(uuid())
  householdId      String             @map("household_id")
  learnedPatternId String?            @map("learned_pattern_id")
  promptType       LearningPromptType @map("prompt_type")
  trigger          String
  payload          Json               @default("{}")
  status           LearningStatus     @default(PENDING)
  createdAt        DateTime           @default(now()) @map("created_at")
  answeredAt       DateTime?          @map("answered_at")

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  learnedPattern LearnedPattern? @relation(fields: [learnedPatternId], references: [id], onDelete: SetNull)

  @@index([householdId, status, createdAt])
  @@map("learning_prompts")
}

enum LearnedPatternType {
  MEAL_CATEGORY_REPLACED_ON_DAY
  MEAL_VARIANT_REPLACED_ON_DAY
  MEAL_CATEGORY_ACCEPTED_ON_DAY
  /// "De afgelopen keren at deze persoon op woensdag niet mee." Pas na
  /// herhaling; één afwijking mag het patroon nooit veranderen.
  PRESENCE_CHANGED_ON_DAY

  @@map("learned_pattern_type")
}

enum LearningPromptType {
  EXPLAIN_REPEATED_REPLACEMENT
  CONFIRM_REPEATED_ACCEPTANCE
  /// "Zal ik dat als standaard houden?" — ja/nee, geen smaakvraag.
  CONFIRM_PRESENCE_PATTERN

  @@map("learning_prompt_type")
}

enum LearningStatus {
  CANDIDATE
  CONFIRMED
  DISMISSED
  PENDING
  ANSWERED

  @@map("learning_status")
}

enum FeedbackSubjectType {
  RECIPE_VARIANT
  PRODUCT
  INGREDIENT
  RECIPE_CATEGORY

  @@map("feedback_subject_type")
}

enum FeedbackEventType {
  CHOSEN
  REPLACED
  IGNORED
  EXPLICIT_FEEDBACK
  RESTORED

  @@map("feedback_event_type")
}

enum FeedbackReason {
  NOT_TASTY
  NO_APPETITE_NOW
  TOO_MUCH_EFFORT
  TOO_REPETITIVE
  WRONG_DAY
  WRONG_PARTICIPANTS
  PRODUCT_WRONG
  ONLY_THIS_TIME
  ALWAYS_USE
  NEVER_USE
  COINCIDENCE

  @@map("feedback_reason")
}

// ── Preference ───────────────────────────────────────────────────────────

model Preference {
  id          String              @id @default(uuid())
  ownerType   PreferenceOwnerType @map("owner_type")
  ownerId     String              @map("owner_id")
  subjectType FeedbackSubjectType @map("subject_type")
  subjectId   String              @map("subject_id")
  stance      Stance              @default(UNKNOWN)
  source      PreferenceSource
  confidence  Float               @default(0)
  // Fase 11: pas ná herhaalde negatieve feedback (niet bij één keer) wordt
  // een gerecht echt uit de suggesties verborgen — zie
  // src/domain/learning/hiddenRecipes.ts. Losstaand van stance/confidence,
  // die blijven de zachte score-bijstelling doen die al bij één beoordeling
  // hoort. Alleen zinvol voor ownerType=HOUSEHOLD, subjectType=RECIPE_VARIANT.
  hiddenAt    DateTime?           @map("hidden_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([ownerType, ownerId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("preferences")
}

enum PreferenceOwnerType {
  HOUSEHOLD
  PERSON

  @@map("preference_owner_type")
}

enum Stance {
  LIKED
  SOMETIMES
  RATHER_NOT
  NEVER
  UNKNOWN

  @@map("stance")
}

enum PreferenceSource {
  EXPLICIT
  INFERRED

  @@map("preference_source")
}

// ── Pushmeldingen (WP70) ─────────────────────────────────────────────────
// Zelfde vier situaties als src/domain/attention/attentionItems.ts — deze
// enum bestaat apart in Prisma omdat die module een TS-uniontype is, geen
// Prisma-enum; de waarden moeten wel exact gelijk blijven.

enum NotificationType {
  WEEK_MENU_READY_NO_GROCERIES
  PRODUCT_REVIEW_OPEN
  GROCERIES_READY_NOT_SENT_TO_PICNIC
  PICNIC_CART_FILLED_NOT_CONFIRMED
  // WP71/72: voorbereid, nog niet aan de cron gekoppeld (dat is WP72).
  PICNIC_DELIVERY_SLOT_AT_RISK

  @@map("notification_type")
}

model PushSubscription {
  id           String    @id @default(uuid())
  householdId  String    @map("household_id")
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  // Nooit hard verwijderen bij een mislukte verzending (410 Gone e.d.) —
  // uitschakelen behoudt een spoor voor foutopsporing (Fase 16-principe).
  disabledAt   DateTime? @map("disabled_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id          String           @id @default(uuid())
  householdId String           @map("household_id")
  type        NotificationType
  // Standaard aan: een huishouden dat nooit iets heeft ingesteld, moet
  // gewoon de rustige standaardherinneringen krijgen (geen rij hier
  // betekent dus ook "aan", zie src/lib/notifications.ts).
  enabled     Boolean          @default(true)
  updatedAt   DateTime         @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, type])
  @@map("notification_preferences")
}

model NotificationDeliveryLog {
  id          String           @id @default(uuid())
  householdId String           @map("household_id")
  type        NotificationType
  // Kalenderdag in Europe/Amsterdam (bijv. "2026-07-30") — bewust een
  // string i.p.v. afgeleid uit `sentAt` in UTC, anders zou de daggrens rond
  // middernacht CET/CEST net verkeerd kunnen vallen bij het bepalen van
  // "al gestuurd vandaag".
  dayKey      String           @map("day_key")
  sentAt      DateTime         @default(now()) @map("sent_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, dayKey])
  @@index([householdId, type, dayKey])
  @@map("notification_delivery_logs")
}

// ── Picnic-bezorgmomenten (WP71) ─────────────────────────────────────────
// Losstaand van het bestaande `Household.deliveryPreference` (JSON) — dat
// veld gaat over productkeuze (goedkoopst/gebalanceerd/premium), niet over
// bezorgdag/-tijd. Bewust relationele velden i.p.v. nog een JSON-blob: het
// zijn duidelijke, individueel te valideren waarden (Fase 2-principe).
model PicnicDeliveryPreference {
  id                   String    @id @default(uuid())
  householdId          String    @unique @map("household_id")
  preferredDayOfWeek   DayOfWeek @map("preferred_day_of_week")
  // "18:00" — bewust een simpele string i.p.v. DateTime: dit is een
  // wekelijks terugkerend tijdstip, geen concreet moment.
  preferredTime        String    @map("preferred_time")
  windowMinutes        Int       @default(60) @map("window_minutes")
  notificationsEnabled Boolean   @default(true) @map("notifications_enabled")
  reminderDaysBefore   Int       @default(2) @map("reminder_days_before")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("picnic_delivery_preferences")
}
