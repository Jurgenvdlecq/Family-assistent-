// Datamodel voor Family Assistant v1.1
// Elf kernentiteiten conform sectie 3 van het technisch ontwerpdocument.
// Polymorfe referenties (owner_type/owner_id, subject_type/subject_id) zijn
// bewust gewone velden zonder Prisma @relation — Prisma ondersteunt geen
// echte polymorfe foreign keys; integriteit wordt op applicatieniveau bewaakt.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Household ────────────────────────────────────────────────────────────

model Household {
  id                          String           @id @default(uuid())
  name                        String
  weeklyRhythm                Json             @default("{}") @map("weekly_rhythm")
  deliveryPreference          Json             @default("{}") @map("delivery_preference")
  onboardingStatus            OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingMode              OnboardingMode   @default(QUICK) @map("onboarding_mode")
  planningStyle               PlanningStyle    @default(BALANCED) @map("planning_style")
  maxSmartQuestionsPerSession Int              @default(2) @map("max_smart_questions_per_session")
  accessCodeHash              String?          @map("access_code_hash")
  // Picnic-integratie (fase 4, verdiept): sessie-token van de niet-officiële
  // Picnic-API. Nooit een wachtwoord — dat komt nooit verder dan het
  // eenmalige login-script van de gebruiker zelf (scripts/picnic-login.ts).
  picnicAuthToken             String?          @map("picnic_auth_token")
  picnicTokenUpdatedAt        DateTime?        @map("picnic_token_updated_at")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  persons                Person[]
  mealPlans              MealPlan[]
  mealSuggestions        MealSuggestion[]
  feedbackEvents         FeedbackEvent[]
  fixedGroceries         FixedGrocery[]
  inventoryItems         InventoryItem[]
  productPreferences     HouseholdProductPreference[]
  rejectedProductMatches RejectedProductMatch[]
  sessions               HouseholdSession[]
  recipes                Recipe[]                     @relation("HouseholdRecipes")
  originatedRecipes      Recipe[]                     @relation("OriginatedRecipes")
  learnedPatterns        LearnedPattern[]
  learningPrompts        LearningPrompt[]
  dayRoutines            DayRoutine[]

  @@map("households")
}

// Een expliciet onthouden daggewoonte (WP51, DATAMODEL_AUDIT.md punt 4:
// "eerst expliciet door de gebruiker, later via leervragen bij herhaling").
// Eén routine per dag per huishouden — een nieuwe keuze onthouden vervangt
// de vorige, net als bij vaste boodschappen. ensureMealPlan gebruikt dit als
// voorstel voor die dag, maar nooit ten koste van een harde beperking.
model DayRoutine {
  id              String    @id @default(uuid())
  householdId     String    @map("household_id")
  dayOfWeek       DayOfWeek @map("day_of_week")
  recipeVariantId String    @map("recipe_variant_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeVariant RecipeVariant @relation(fields: [recipeVariantId], references: [id])

  @@unique([householdId, dayOfWeek])
  @@map("day_routines")
}

model HouseholdSession {
  id          String   @id @default(uuid())
  householdId String   @map("household_id")
  tokenHash   String   @unique @map("token_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([expiresAt])
  @@map("household_sessions")
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED

  @@map("onboarding_status")
}

enum OnboardingMode {
  QUICK
  DETAILED

  @@map("onboarding_mode")
}

enum PlanningStyle {
  SAFE
  BALANCED
  ADVENTUROUS

  @@map("planning_style")
}

// Vaste, terugkerende boodschappen van een huishouden (melk, koffie, kaas…)
model FixedGrocery {
  id           String @id @default(uuid())
  householdId  String @map("household_id")
  ingredientId String @map("ingredient_id")
  quantity     Float
  unit         Unit

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("fixed_groceries")
}

// Eenvoudige voorraadstatus per huishouden + ingrediënt (Fase 2: "geen
// complex magazijnsysteem"). `status` is de bron van waarheid voor de
// boodschappenflow; `quantity`/`unit` zijn optioneel voor wie een preciezer
// aantal wil vastleggen. Blijft — in tegenstelling tot Picnic-besteller —
// gewoon bewaard tussen weken totdat de gebruiker het zelf bijwerkt.
model InventoryItem {
  id           String          @id @default(uuid())
  householdId  String          @map("household_id")
  ingredientId String          @map("ingredient_id")
  status       InventoryStatus @default(UNKNOWN)
  quantity     Float?
  unit         Unit?
  updatedAt    DateTime        @updatedAt @map("updated_at")

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("inventory_items")
}

enum InventoryStatus {
  SUFFICIENT
  LOW
  OUT_OF_STOCK
  UNKNOWN

  @@map("inventory_status")
}

// ── Person ───────────────────────────────────────────────────────────────

model Person {
  id                String     @id @default(uuid())
  householdId       String     @map("household_id")
  name              String
  role              PersonRole @default(OTHER)
  hardRestrictions  Json       @default("[]") @map("hard_restrictions")
  defaultPresent    Boolean    @default(true) @map("default_present")
  portionMultiplier Float      @default(1) @map("portion_multiplier")
  createdAt         DateTime   @default(now()) @map("created_at")

  household         Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  feedbackEvents    FeedbackEvent[]
  presenceOverrides PersonPresenceOverride[]

  @@index([householdId])
  @@map("persons")
}

model PersonPresenceOverride {
  id        String    @id @default(uuid())
  personId  String    @map("person_id")
  dayOfWeek DayOfWeek @map("day_of_week")
  present   Boolean
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, dayOfWeek])
  @@index([personId])
  @@map("person_presence_overrides")
}

enum PersonRole {
  PARENT
  CHILD
  OTHER

  @@map("person_role")
}

// ── Recipe & RecipeVariant ──────────────────────────────────────────────

model Recipe {
  id                String         @id @default(uuid())
  title             String
  category          RecipeCategory
  source            String?
  imageUrl          String?        @map("image_url")
  imageAttribution  String?        @map("image_attribution")
  imageSourceUrl    String?        @map("image_source_url")
  properties        String[]       @default([])
  instructions      String[]       @default([])
  status            RecipeStatus   @default(FOUND)
  scope             RecipeScope    @default(GLOBAL)
  householdId       String?        @map("household_id")
  originHouseholdId String?        @map("origin_household_id")
  promotedAt        DateTime?      @map("promoted_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  household       Household?         @relation("HouseholdRecipes", fields: [householdId], references: [id], onDelete: Cascade)
  originHousehold Household?         @relation("OriginatedRecipes", fields: [originHouseholdId], references: [id], onDelete: SetNull)
  ingredients     RecipeIngredient[]
  variants        RecipeVariant[]

  @@index([scope, householdId, title])
  @@map("recipes")
}

enum RecipeScope {
  GLOBAL
  HOUSEHOLD
  COMMUNITY_CANDIDATE
  COMMUNITY_APPROVED

  @@map("recipe_scope")
}

enum RecipeCategory {
  PASTA
  WRAPS
  RICE_DISH
  ALL_VEGGIE_DAY
  QUICK_AND_EASY
  COMFORT_FOOD
  AIRFRYER
  OTHER

  @@map("recipe_category")
}

enum RecipeStatus {
  FOUND
  ADAPTED
  PROVEN
  SAFE_CHOICE

  @@map("recipe_status")
}

// Join-tabel: ingrediënt + hoeveelheid per recept (basisrecept, vóór variant-overrides)
model RecipeIngredient {
  id           String @id @default(uuid())
  recipeId     String @map("recipe_id")
  ingredientId String @map("ingredient_id")
  quantity     Float
  unit         Unit

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeVariant {
  id                  String      @id @default(uuid())
  recipeId            String      @map("recipe_id")
  variantType         VariantType @map("variant_type")
  ingredientOverrides Json        @default("{}") @map("ingredient_overrides")
  contextFit          String[]    @default([]) @map("context_fit")
  createdAt           DateTime    @default(now()) @map("created_at")

  recipe                          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealSuggestions                 MealSuggestion[]
  mealPlanEntries                 MealPlanEntry[]
  dayRoutines                     DayRoutine[]
  mealPlanEntriesReplacedFromThis MealPlanEntry[]  @relation("MealPlanEntryReplacedFrom")

  @@unique([recipeId, variantType])
  @@map("recipe_variants")
}

enum VariantType {
  FAST
  FRESH
  REHEATABLE
  KID_FRIENDLY

  @@map("variant_type")
}

// ── MealPlan ─────────────────────────────────────────────────────────────

model MealPlan {
  id          String         @id @default(uuid())
  householdId String         @map("household_id")
  weekStart   DateTime       @map("week_start") @db.Date
  status      MealPlanStatus @default(CONCEPT)
  createdAt   DateTime       @default(now()) @map("created_at")

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries      MealPlanEntry[]
  shoppingList ShoppingList?

  @@unique([householdId, weekStart])
  @@map("meal_plans")
}

enum MealPlanStatus {
  CONCEPT
  CONFIRMED
  GROCERIES_READY

  @@map("meal_plan_status")
}

// De 7 dagregels van een weekplanning
//
// source/status/reason/score/confidenceLevel (WP52, DATAMODEL_AUDIT.md
// punt 6) maken onderscheid tussen "de app heeft dit voorgesteld en de
// gebruiker heeft er niets aan veranderd" (stilzwijgende bevestiging is
// zelf ook een signaal, PRODUCT_VISION.md: "Stilte is feedback") en een
// expliciete, actieve keuze — nodig om daar later verschillend van te
// kunnen leren.
model MealPlanEntry {
  id                          String              @id @default(uuid())
  mealPlanId                  String              @map("meal_plan_id")
  dayOfWeek                   DayOfWeek           @map("day_of_week")
  recipeVariantId             String              @map("recipe_variant_id")
  source                      MealPlanEntrySource @default(AUTO) @map("source")
  status                      MealPlanEntryStatus @default(PROPOSED) @map("status")
  reason                      String?             @map("reason")
  score                       Float?              @map("score")
  confidenceLevel             ConfidenceLevel?    @map("confidence_level")
  replacedFromRecipeVariantId String?             @map("replaced_from_recipe_variant_id")
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  mealPlan            MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeVariant       RecipeVariant  @relation(fields: [recipeVariantId], references: [id])
  replacedFromVariant RecipeVariant? @relation("MealPlanEntryReplacedFrom", fields: [replacedFromRecipeVariantId], references: [id], onDelete: SetNull)

  @@unique([mealPlanId, dayOfWeek])
  @@map("meal_plan_entries")
}

enum MealPlanEntrySource {
  AUTO
  MANUAL
  ASSISTANT
  REGENERATED

  @@map("meal_plan_entry_source")
}

enum MealPlanEntryStatus {
  PROPOSED
  ACCEPTED
  REPLACED

  @@map("meal_plan_entry_status")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
}

// ── MealSuggestion ───────────────────────────────────────────────────────

model MealSuggestion {
  id              String          @id @default(uuid())
  householdId     String          @map("household_id")
  recipeVariantId String          @map("recipe_variant_id")
  reason          String
  confidenceLevel ConfidenceLevel @map("confidence_level")
  targetSlot      DateTime        @map("target_slot") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeVariant RecipeVariant @relation(fields: [recipeVariantId], references: [id])

  @@index([householdId, targetSlot])
  @@map("meal_suggestions")
}

enum ConfidenceLevel {
  CERTAIN
  SLIGHT_DOUBT
  HIGH_IMPACT

  @@map("confidence_level")
}

// ── Ingredient & Product ─────────────────────────────────────────────────

model Ingredient {
  id              String             @id @default(uuid())
  name            String             @unique
  unit            Unit
  category        IngredientCategory
  // Gecontroleerd vocabulaire (zie src/lib/dietaryRestrictions.ts) waarmee
  // een harde beperking van een gezinslid ("pinda's", "lactose", ...)
  // betrouwbaar aan een ingrediënt kan worden gekoppeld. Bewust geen vrije
  // tekst: alleen tags uit dat vocabulaire mogen hier terechtkomen.
  restrictionTags String[]           @default([]) @map("restriction_tags")
  // Kandidaat voor de voorraadcontrole (Fase 4): een pantry-basisproduct dat
  // waarschijnlijk al in huis is (olie, bloem, bouillon, ...), dus de moeite
  // waard om ernaar te vragen — in tegenstelling tot verse producten die
  // sowieso elke keer opnieuw gekocht worden.
  likelyInStock   Boolean            @default(false) @map("likely_in_stock")

  recipeIngredients      RecipeIngredient[]
  fixedGroceries         FixedGrocery[]
  products               Product[]
  shoppingListLines      ShoppingListLine[]
  inventoryItems         InventoryItem[]
  productPreferences     HouseholdProductPreference[]
  rejectedProductMatches RejectedProductMatch[]

  @@map("ingredients")
}

enum Unit {
  GRAM
  PIECE
  ML

  @@map("unit")
}

enum IngredientCategory {
  MEAT
  FISH
  DAIRY
  VEGETABLE
  FRUIT
  GRAIN
  LEGUME
  PANTRY
  OTHER

  @@map("ingredient_category")
}

model Product {
  id                String    @id @default(uuid())
  ingredientId      String?   @map("ingredient_id")
  externalRef       String?   @map("external_ref")
  picnicImageId     String?   @map("picnic_image_id")
  name              String
  brand             String?
  packageSize       String?   @map("package_size")
  // Structureel aantal eenheden (in de eenheid van het gekoppelde
  // Ingredient) per verpakking — bv. 500 voor "500 gram", 4 voor "4 stuks".
  // Null wanneer packageSize niet betrouwbaar te herleiden is tot de
  // ingrediënt-eenheid (zie src/lib/quantity/parsePackageSize.ts); dan is
  // handmatige controle nodig in plaats van een geraden waarde.
  packageQuantity   Float?    @map("package_quantity")
  price             Decimal?  @db.Decimal(10, 2)
  lastSeenAvailable DateTime? @map("last_seen_available")

  ingredient           Ingredient?                  @relation(fields: [ingredientId], references: [id])
  shoppingListLines    ShoppingListLine[]
  householdPreferences HouseholdProductPreference[]
  rejections           RejectedProductMatch[]

  @@unique([ingredientId, externalRef])
  @@index([ingredientId])
  @@map("products")
}

// Vervangt het generieke gebruik van Preference{subjectType: PRODUCT} met
// iets rijkers (Fase 2 / Fase 5): niet alleen "vertrouwd of niet", maar ook
// hoe vaak en wanneer voor het laatst gekozen, en of dat automatisch of
// handmatig gebeurde. Eén actieve voorkeur per ingrediënt per huishouden.
model HouseholdProductPreference {
  id           String                  @id @default(uuid())
  householdId  String                  @map("household_id")
  ingredientId String                  @map("ingredient_id")
  productId    String                  @map("product_id")
  timesChosen  Int                     @default(1) @map("times_chosen")
  lastChosenAt DateTime                @default(now()) @map("last_chosen_at")
  confidence   Float                   @default(1)
  source       ProductPreferenceSource @default(MANUAL)

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([householdId, ingredientId])
  @@map("household_product_preferences")
}

enum ProductPreferenceSource {
  MANUAL
  AUTOMATIC

  @@map("product_preference_source")
}

// Een product dat een huishouden expliciet heeft afgewezen voor een
// ingrediënt — sluit het uit van toekomstige automatische matches voor dat
// ingrediënt (Fase 5: "afgewezen producten").
model RejectedProductMatch {
  id           String   @id @default(uuid())
  householdId  String   @map("household_id")
  ingredientId String   @map("ingredient_id")
  productId    String   @map("product_id")
  reason       String?
  rejectedAt   DateTime @default(now()) @map("rejected_at")

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([householdId, ingredientId, productId])
  @@map("rejected_product_matches")
}

// ── ShoppingList ─────────────────────────────────────────────────────────

model ShoppingList {
  id         String             @id @default(uuid())
  mealPlanId String             @unique @map("meal_plan_id")
  status     ShoppingListStatus @default(PREPARED)
  createdAt  DateTime           @default(now()) @map("created_at")

  mealPlan MealPlan           @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  lines    ShoppingListLine[]

  @@map("shopping_lists")
}

enum ShoppingListStatus {
  PREPARED
  REVIEWED
  TRANSFERRED

  @@map("shopping_list_status")
}

model ShoppingListLine {
  id              String      @id @default(uuid())
  shoppingListId  String      @map("shopping_list_id")
  ingredientId    String      @map("ingredient_id")
  productId       String?     @map("product_id")
  quantity        Float
  unit            Unit
  source          LineSource
  needsReview     Boolean     @default(false) @map("needs_review")
  // Uitlegbare productmatching (Fase 5) — needsReview blijft de simpele
  // boolean die de bestaande UI al gebruikt, deze velden voegen het "hoe
  // zeker, en waarom" toe. matchReasons is bewust String[] i.p.v. één
  // opgebouwde zin: elk element is een losse, voor de gebruiker leesbare
  // reden (zie src/domain/product-matching).
  matchStatus     MatchStatus @default(NOT_FOUND) @map("match_status")
  matchConfidence Float       @default(0) @map("match_confidence")
  matchReasons    String[]    @default([]) @map("match_reasons")

  // Fase 7/8: per-regel idempotentie voor het vullen van het Picnic-mandje —
  // een regel die al is overgedragen wordt bij een herhaalde poging
  // overgeslagen in plaats van dubbel toegevoegd.
  transferredToPicnicAt DateTime? @map("transferred_to_picnic_at")

  // Nooit stilzwijgend onder-bestellen (Fase 3/8): als een regel handmatig
  // (of nog niet bijgewerkt) onder de daadwerkelijke receptbehoefte van deze
  // week staat, moet de gebruiker dat expliciet zien en bevestigen dat dit
  // oké is — anders blijft de melding terugkomen. Wordt teruggezet zodra de
  // hoeveelheid weer handmatig wijzigt, zodat een nieuw tekort niet stil
  // wordt overgeslagen.
  shortfallAcknowledged Boolean @default(false) @map("shortfall_acknowledged")

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([shoppingListId])
  @@index([shoppingListId, needsReview])
  @@index([shoppingListId, ingredientId, source])
  @@map("shopping_list_lines")
}

enum MatchStatus {
  MATCHED_TRUSTED
  MATCHED_REVIEW_REQUIRED
  NOT_FOUND
  MANUALLY_SELECTED
  UNAVAILABLE

  @@map("match_status")
}

enum LineSource {
  MEAL
  FIXED
  // Toegevoegd omdat de voorraadcontrole een pantry-item als "bijna op"/"op"
  // markeerde, terwijl geen enkel recept deze week dat ingrediënt gebruikt —
  // dus geen MEAL-regel om aan te vullen. Altijd needsReview: de gebruiker
  // gaf alleen een status door, geen exacte hoeveelheid.
  INVENTORY

  @@map("line_source")
}

// ── FeedbackEvent ────────────────────────────────────────────────────────

model FeedbackEvent {
  id          String              @id @default(uuid())
  householdId String              @map("household_id")
  personId    String?             @map("person_id")
  subjectType FeedbackSubjectType @map("subject_type")
  subjectId   String              @map("subject_id")
  eventType   FeedbackEventType   @map("event_type")
  reason      FeedbackReason?
  explicit    Boolean             @default(false)
  context     Json                @default("{}")
  createdAt   DateTime            @default(now()) @map("created_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person?   @relation(fields: [personId], references: [id])

  @@index([householdId, subjectType, subjectId])
  @@index([householdId, eventType, subjectType, subjectId])
  @@map("feedback_events")
}

// ── Learning ─────────────────────────────────────────────────────────────

model LearnedPattern {
  id             String               @id @default(uuid())
  householdId    String               @map("household_id")
  personId       String?              @map("person_id")
  patternType    LearnedPatternType   @map("pattern_type")
  subjectType    FeedbackSubjectType? @map("subject_type")
  subjectId      String?              @map("subject_id")
  contextKey     String               @map("context_key")
  context        Json                 @default("{}")
  confidence     Float                @default(0)
  evidenceCount  Int                  @default(0) @map("evidence_count")
  status         LearningStatus       @default(CANDIDATE)
  lastObservedAt DateTime             @default(now()) @map("last_observed_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  prompts   LearningPrompt[]

  @@unique([householdId, patternType, subjectType, subjectId, contextKey])
  @@index([householdId, status])
  @@map("learned_patterns")
}

model LearningPrompt {
  id               String             @id @default(uuid())
  householdId      String             @map("household_id")
  learnedPatternId String?            @map("learned_pattern_id")
  promptType       LearningPromptType @map("prompt_type")
  trigger          String
  payload          Json               @default("{}")
  status           LearningStatus     @default(PENDING)
  createdAt        DateTime           @default(now()) @map("created_at")
  answeredAt       DateTime?          @map("answered_at")

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  learnedPattern LearnedPattern? @relation(fields: [learnedPatternId], references: [id], onDelete: SetNull)

  @@index([householdId, status, createdAt])
  @@map("learning_prompts")
}

enum LearnedPatternType {
  MEAL_CATEGORY_REPLACED_ON_DAY
  MEAL_VARIANT_REPLACED_ON_DAY

  @@map("learned_pattern_type")
}

enum LearningPromptType {
  EXPLAIN_REPEATED_REPLACEMENT

  @@map("learning_prompt_type")
}

enum LearningStatus {
  CANDIDATE
  CONFIRMED
  DISMISSED
  PENDING
  ANSWERED

  @@map("learning_status")
}

enum FeedbackSubjectType {
  RECIPE_VARIANT
  PRODUCT
  INGREDIENT
  RECIPE_CATEGORY

  @@map("feedback_subject_type")
}

enum FeedbackEventType {
  CHOSEN
  REPLACED
  IGNORED
  EXPLICIT_FEEDBACK

  @@map("feedback_event_type")
}

enum FeedbackReason {
  NOT_TASTY
  NO_APPETITE_NOW
  TOO_MUCH_EFFORT
  TOO_REPETITIVE
  WRONG_DAY
  WRONG_PARTICIPANTS
  PRODUCT_WRONG
  ONLY_THIS_TIME
  ALWAYS_USE
  NEVER_USE
  COINCIDENCE

  @@map("feedback_reason")
}

// ── Preference ───────────────────────────────────────────────────────────

model Preference {
  id          String              @id @default(uuid())
  ownerType   PreferenceOwnerType @map("owner_type")
  ownerId     String              @map("owner_id")
  subjectType FeedbackSubjectType @map("subject_type")
  subjectId   String              @map("subject_id")
  stance      Stance              @default(UNKNOWN)
  source      PreferenceSource
  confidence  Float               @default(0)
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([ownerType, ownerId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("preferences")
}

enum PreferenceOwnerType {
  HOUSEHOLD
  PERSON

  @@map("preference_owner_type")
}

enum Stance {
  LIKED
  SOMETIMES
  RATHER_NOT
  NEVER
  UNKNOWN

  @@map("stance")
}

enum PreferenceSource {
  EXPLICIT
  INFERRED

  @@map("preference_source")
}
