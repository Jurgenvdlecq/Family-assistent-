# Kopieer naar `.env` en vul in. Nooit `.env` zelf committen (staat al in
# .gitignore).

# Verplicht — lokale PostgreSQL-connectiestring.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_assistant"

# Optioneel, alleen nodig voor productiemigraties tegen een gepoolde database
# (bijv. Supabase) — zie OPERATIONS.md, sectie "Productie-migraties tegen
# Supabase". Lokaal (geen pooler) kan dit leeg blijven; valt dan terug op
# DATABASE_URL.
# DIRECT_URL="postgresql://..."

# Optioneel — alleen nodig om pushmeldingen (WP70) lokaal te testen. Genereer
# een eigen testkeypaar, gebruik nooit het productiekeypaar lokaal.
# WEB_PUSH_PUBLIC_KEY=""
# WEB_PUSH_PRIVATE_KEY=""
# WEB_PUSH_SUBJECT="mailto:jouw@email.nl"

# Optioneel — alleen nodig om de cron-route (/api/cron/reminders) lokaal te
# beveiligen zoals in productie.
# CRON_SECRET=""
